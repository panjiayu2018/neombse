---
import MainLayout from '../../layouts/MainLayout.astro';
import { formatDate, tools } from '../../lib/tools';
import type { Tool } from '../../types';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props { tool: Tool; }
const { tool } = Astro.props;
const featureLabels: Record<keyof Tool['features'], string> = {
  xmiImport: 'XMI import',
  xmiExport: 'XMI export',
  collaboration: 'Team collaboration',
  codeGeneration: 'Code generation',
  reverseEngineering: 'Reverse engineering',
  simulation: 'Model simulation',
  requirementsManagement: 'Requirements management',
  sysmlV2Api: 'SysML v2 API',
};
const environmentTags = tool.operatingSystems.length
  ? tool.operatingSystems
  : tool.deliveryModes.includes('Web Application')
    ? ['Web browser']
    : tool.deliveryModes;
const listOrUnknown = (values: string[]) => values.length ? values.join(', ') : 'Not applicable / not verified';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: tool.operatingSystems.length ? tool.operatingSystems.join(', ') : 'Web browser',
  description: tool.description,
  url: tool.website,
};
---

<MainLayout title={`${tool.name}: operating systems, licensing, and capabilities — NeoMBSE`} description={tool.description} canonicalPath={`/tools/${tool.id}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article>
    <header class="tool-hero">
      <div class="container">
        <a class="back-link" href="/tools/">← Back to all tools</a>
        <div class="tool-heading">
          <div class="tool-title-block">
            {tool.image && <img class="tool-logo" src={tool.image} alt={`${tool.name} interface or logo`} />}
            <div><p class="eyebrow">{tool.vendor}</p><h1>{tool.name}</h1><p class="lead">{tool.description}</p></div>
          </div>
          <a class="button button--accent" href={tool.website} target="_blank" rel="noopener noreferrer">Visit official site ↗</a>
        </div>
        <div class="tag-row">
          {environmentTags.map((item) => <span class="tag">{item}</span>)}
          {tool.standards.map((item) => <span class="tag">{item}</span>)}
          <span class="tag">{tool.sourceLicense}</span>
          {tool.pricingModels.map((item) => <span class="tag">{item}</span>)}
        </div>
      </div>
    </header>

    <div class="container detail-grid">
      <main>
        <section>
          <p class="eyebrow">Evidence matrix</p>
          <h2>Verified capabilities</h2>
          <p>Unknown means the capability has not yet been verified; it does not mean the product lacks it.</p>
          <div class="capability-list">
            {Object.entries(tool.features).map(([key, value]) => {
              const evidence = tool.featureEvidence?.[key as keyof Tool['features']];
              return (
                <div class="capability-row">
                  <div class="capability-copy">
                    <span>{featureLabels[key as keyof Tool['features']]}</span>
                    {evidence && (
                      <p>
                        {evidence.availability && <span class="evidence-type">{evidence.availability}</span>}
                        {evidence.note && <span>{evidence.note}</span>}
                        <a href={evidence.url} target="_blank" rel="noopener noreferrer">Evidence source ↗</a>
                      </p>
                    )}
                  </div>
                  <strong class:list={[`state--${value.toLowerCase()}`]}>{value}</strong>
                </div>
              );
            })}
          </div>
        </section>
        {tool.classificationNotes && tool.classificationNotes.length > 0 && (
          <section>
            <p class="eyebrow">Scope and classification</p>
            <h2>Important distinctions</h2>
            <ul class="scope-notes">
              {tool.classificationNotes.map((note) => <li>{note}</li>)}
            </ul>
          </section>
        )}
        <section>
          <p class="eyebrow">Evidence sources</p>
          <h2>Sources reviewed</h2>
          <ol class="source-list">
            {tool.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}
          </ol>
        </section>
      </main>

      <aside class="facts panel">
        <h2>Tool profile</h2>
        <dl>
          <div><dt>Vendor</dt><dd>{tool.vendor}</dd></div>
          <div><dt>Operating systems</dt><dd>{listOrUnknown(tool.operatingSystems)}</dd></div>
          <div><dt>Delivery / access</dt><dd>{listOrUnknown(tool.deliveryModes)}</dd></div>
          <div><dt>Runtime</dt><dd>{listOrUnknown(tool.runtimes)}</dd></div>
          <div><dt>Host applications</dt><dd>{listOrUnknown(tool.hostApplications)}</dd></div>
          <div><dt>Standards</dt><dd>{tool.standards.join(', ')}</dd></div>
          <div><dt>Tool type</dt><dd>{tool.toolTypes.join(', ')}</dd></div>
          <div><dt>Interface</dt><dd>{tool.modelingModes.join(', ')}</dd></div>
          <div><dt>Source license</dt><dd>{tool.sourceLicense}{tool.spdxLicenseId ? ` · ${tool.spdxLicenseId}` : ''}</dd></div>
          <div><dt>Pricing model</dt><dd>{tool.pricingModels.join(', ')}</dd></div>
          <div><dt>License term</dt><dd>{tool.licenseTerms.join(', ')}</dd></div>
          <div><dt>Latest version</dt><dd>{tool.latestVersion ?? 'Not yet verified'}</dd></div>
          <div><dt>Release date</dt><dd>{formatDate(tool.releaseDate)}</dd></div>
          <div><dt>Last checked</dt><dd>{formatDate(tool.lastChecked)}</dd></div>
        </dl>
      </aside>
    </div>
  </article>
</MainLayout>

<style>
  .tool-hero { padding: 3rem 0 4rem; border-bottom: 1px solid var(--line); }
  .back-link { display: inline-block; margin-bottom: 3rem; color: var(--teal-dark); font-weight: 800; text-decoration: none; }
  .tool-heading { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; }
  .tool-title-block { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.2rem; }
  .tool-logo { width: 120px; height: 90px; padding: .5rem; border: 1px solid var(--line); border-radius: 16px; background: white; object-fit: contain; }
  .tool-heading h1 { font-size: clamp(2.7rem, 7vw, 5rem); }
  .tool-heading .lead { max-width: 760px; margin-top: 1rem; }
  .tool-hero .tag-row { margin-top: 1.5rem; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; align-items: start; gap: clamp(2rem, 6vw, 5rem); padding-block: 5rem 7rem; }
  main section + section { margin-top: 5rem; }
  main h2, .facts h2 { margin-bottom: 1rem; font-size: 2rem; }
  main > section > p:not(.eyebrow) { color: var(--ink-soft); }
  .capability-list { margin-top: 1.4rem; border-top: 1px solid var(--line); }
  .capability-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .capability-copy { display: grid; gap: .35rem; }
  .capability-copy > span { font-weight: 750; }
  .capability-copy p { display: flex; flex-wrap: wrap; gap: .35rem .65rem; margin: 0; color: var(--ink-soft); font-size: .78rem; }
  .capability-copy a { color: var(--teal-dark); font-weight: 750; }
  .evidence-type { padding: .08rem .38rem; border-radius: 999px; background: var(--paper-deep); color: var(--ink); font-family: var(--font-mono); font-size: .66rem; font-weight: 800; }
  .capability-list strong { min-width: 86px; padding: .25rem .5rem; border-radius: 999px; font-family: var(--font-mono); font-size: .72rem; text-align: center; }
  .state--yes { background: #d6eadf; color: var(--green); }
  .state--no { background: #f2d8d2; color: var(--red); }
  .state--unknown { background: var(--paper-deep); color: var(--ink-soft); }
  .source-list { padding-left: 1.2rem; }
  .source-list li + li { margin-top: .5rem; }
  .source-list a { color: var(--teal-dark); font-weight: 750; }
  .scope-notes { padding-left: 1.2rem; }
  .scope-notes li + li { margin-top: .65rem; }
  .facts { position: sticky; top: 1.5rem; padding: 1.25rem; }
  dl { margin: 0; }
  dl div { padding: .8rem 0; border-top: 1px solid var(--line); }
  dt { color: var(--ink-soft); font-family: var(--font-mono); font-size: .68rem; font-weight: 700; text-transform: uppercase; }
  dd { margin: .18rem 0 0; font-weight: 700; }
  @media (max-width: 880px) { .tool-heading, .detail-grid { grid-template-columns: 1fr; } .tool-heading .button { justify-self: start; } .facts { position: static; } }
  @media (max-width: 560px) { .tool-title-block { grid-template-columns: 1fr; } .tool-logo { width: 100px; height: 76px; } }
</style>
