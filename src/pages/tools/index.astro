---
import MainLayout from '../../layouts/MainLayout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import { tools } from '../../lib/tools';
---

<MainLayout title="Explore UML & SysML Tools — NeoMBSE" description="Search and filter UML, SysML v1, and SysML v2 tools by operating system, delivery mode, standard, source license, pricing, and capability.">
  <header class="directory-hero">
    <div class="container">
      <p class="eyebrow">Tool directory / {tools.length} records</p>
      <div class="directory-heading">
        <h1>Explore modeling tools.</h1>
        <p class="lead">Start broad, then narrow the catalog by operating system, delivery mode, standard, source license, pricing, or verified capability.</p>
      </div>
    </div>
  </header>
  <section class="container directory-wrap"><ToolDirectory tools={tools} /></section>
</MainLayout>

<style>
  .directory-hero { padding: clamp(3.5rem, 7vw, 6rem) 0 2rem; }
  .directory-heading { display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: 2rem; }
  .directory-heading .lead { margin: 0; }
  .directory-wrap { padding-bottom: 7rem; }
  @media (max-width: 760px) { .directory-heading { grid-template-columns: 1fr; } }
</style>
