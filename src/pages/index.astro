---
import MainLayout from '../layouts/MainLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import ToolDirectory from '../components/ToolDirectory.astro';
import { featuredTools, tools } from '../lib/tools';
import { featuredArticle } from '../data/articles';

const standardCount = new Set(tools.flatMap((tool) => tool.standards)).size;
const operatingSystemCount = new Set(tools.flatMap((tool) => tool.operatingSystems)).size;
---

<MainLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent modeling tool directory</p>
        <h1>Choose tools by <em>evidence,</em> not noise.</h1>
        <p class="lead">Explore UML, SysML v1, and SysML v2 tools by operating system, delivery mode, source license, pricing, and verified capabilities.</p>
      </div>
      <div class="hero-map panel" aria-label="Directory summary">
        <div class="map-orbit" aria-hidden="true">
          <span class="node node--a">UML</span>
          <span class="node node--b">SysML v1</span>
          <span class="node node--c">SysML v2</span>
          <span class="map-core map-core--logo"></span>
        </div>
        <div class="map-stats">
          <div><strong>{tools.length}</strong><span>tools</span></div>
          <div><strong>{operatingSystemCount}</strong><span>operating systems</span></div>
          <div><strong>{standardCount}</strong><span>standards</span></div>
        </div>
      </div>
    </div>
    <div class="container home-directory">
      <ToolDirectory tools={tools} deferResults />
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">From the catalog</p><h2>Representative tools.</h2></div>
        <div class="heading-action"><p>Browse UML and SysML tools across operating systems, delivery modes, standards, and licensing models.</p><a href="/tools/">View all {tools.length} tools →</a></div>
      </div>
      <div class="tool-grid">{featuredTools.map((tool) => <ToolCard tool={tool} />)}</div>
    </div>
  </section>

  <section class="section article-feature">
    <div class="container article-feature-grid">
      <a class="article-feature-image" href={`/articles/${featuredArticle.slug}/`} aria-label={`Read ${featuredArticle.title}`}>
        <img src={featuredArticle.coverImage} alt={featuredArticle.coverAlt} width="1028" height="328" loading="lazy" />
      </a>
      <div>
        <p class="eyebrow">Applied modeling note</p>
        <h2>{featuredArticle.title}</h2>
        <p>{featuredArticle.summary}</p>
        <div class="article-feature-meta">
          <span>{featuredArticle.category}</span>
          <span>{featuredArticle.figureCount} figures</span>
        </div>
        <a class="article-feature-link" href={`/articles/${featuredArticle.slug}/`}>Read the article →</a>
      </div>
    </div>
  </section>

  <section class="section method-strip">
    <div class="container method-grid">
      <div><p class="eyebrow">Verified capabilities</p><h2>“Unknown” is a useful answer.</h2></div>
      <div>
        <p class="lead">A missing claim is not proof that a feature is absent. NeoMBSE records Yes, No, or Unknown—and attaches evidence when a capability is confirmed.</p>
        <a class="button button--accent" href="/methodology/">Read the methodology</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero { padding: clamp(4rem, 9vw, 8rem) 0 2rem; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .hero h1 { max-width: 820px; }
  .hero h1 em { color: var(--teal); font-style: normal; }
  .hero-copy .lead { max-width: 720px; margin: 1.7rem 0 0; }
  .hero-map { padding: 1.1rem; transform: rotate(1.5deg); }
  .map-orbit { position: relative; display: grid; height: 280px; place-items: center; margin: 0 0 1rem; border: 1px dashed var(--line); border-radius: 50%; }
  .map-orbit::before { position: absolute; width: 65%; height: 65%; border: 1px dashed var(--line); border-radius: 50%; content: ""; }
  .map-core { z-index: 1; width: 96px; height: 96px; }
  .map-core--logo { background: url('/brand/neombse-logo.png') left center / auto 100% no-repeat; mix-blend-mode: multiply; }
  .node { position: absolute; z-index: 2; padding: .35rem .55rem; border: 1px solid var(--ink); border-radius: 7px; background: var(--paper); font-family: var(--font-mono); font-size: .7rem; font-weight: 700; }
  .node--a { top: 12%; left: 8%; }
  .node--b { right: 4%; bottom: 28%; }
  .node--c { bottom: 7%; left: 24%; background: var(--orange-soft); }
  .map-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .map-stats div { padding: .7rem; border-radius: 10px; background: var(--paper); }
  .map-stats strong, .map-stats span { display: block; }
  .map-stats strong { font-size: 1.45rem; }
  .map-stats span { color: var(--ink-soft); font-size: .65rem; }
  .home-directory { margin-top: 3rem; }
  .featured-section { background: rgba(255,253,248,.52); }
  .heading-action { color: var(--ink-soft); }
  .heading-action a { color: var(--teal-dark); font-weight: 800; }
  .article-feature { padding-block: clamp(3rem, 6vw, 5rem); }
  .article-feature-grid { display: grid; grid-template-columns: minmax(260px, .72fr) minmax(0, 1.28fr); align-items: center; gap: clamp(2rem, 5vw, 4.5rem); max-width: 1000px; }
  .article-feature-image { display: grid; place-items: center; padding: 1rem; border: 1px solid var(--line); border-radius: 14px; background: white; box-shadow: 0 12px 28px rgba(16, 37, 43, .07); }
  .article-feature-image img { width: 100%; height: auto; }
  .article-feature h2 { font-size: clamp(1.7rem, 3.3vw, 2.55rem); line-height: 1.15; }
  .article-feature h2 + p { margin-top: 1rem; color: var(--ink-soft); }
  .article-feature-meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin: 1rem 0; color: var(--ink-soft); font-family: var(--font-mono); font-size: .72rem; }
  .article-feature-link { color: var(--teal-dark); font-weight: 800; }
  .method-strip { background: var(--teal-dark); color: var(--paper); }
  .method-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .method-strip .eyebrow, .method-strip .lead { color: var(--paper); }
  .method-strip .button { margin-top: 1rem; }
  @media (max-width: 860px) {
    .hero-grid, .method-grid { grid-template-columns: 1fr; }
    .article-feature-grid { grid-template-columns: 1fr; }
    .article-feature-image { max-width: 560px; }
    .hero-map { max-width: 560px; transform: none; }
  }
</style>
