---
interface Props {
  number: number;
  src: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
}

const { number, src, alt, caption, width, height } = Astro.props;
---

<figure id={`figure-${number}`} class="article-figure">
  <a class="figure-image" href={src} target="_blank" rel="noreferrer" aria-label={`Open Figure ${number} at full size`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </a>
  <figcaption>
    <span><strong>Figure {number}.</strong> {caption}</span>
    <a href={src} target="_blank" rel="noreferrer">View full size ↗</a>
  </figcaption>
</figure>

<style>
  .article-figure { margin: 2rem 0 3rem; scroll-margin-top: 2rem; }
  .figure-image { display: block; overflow: auto; border: 1px solid var(--line); border-radius: 14px; background: white; box-shadow: 0 14px 34px rgba(16, 37, 43, .08); }
  .figure-image img { width: 100%; height: auto; }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; padding-top: .75rem; color: var(--ink-soft); font-size: .82rem; line-height: 1.5; }
  figcaption a { flex: 0 0 auto; color: var(--teal-dark); font-family: var(--font-mono); font-size: .72rem; font-weight: 700; text-decoration: none; }
  @media (max-width: 620px) {
    .article-figure { margin: 1.5rem 0 2.5rem; }
    figcaption { flex-direction: column; gap: .35rem; }
  }
</style>
