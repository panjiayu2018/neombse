---
import type { Tool } from '../types';
import ToolCard from './ToolCard.astro';

interface Props { tools: Tool[]; deferResults?: boolean; }
const { tools, deferResults = false } = Astro.props;
const operatingSystems = [...new Set(tools.flatMap((tool) => tool.operatingSystems))].sort();
const deliveryModes = [...new Set(tools.flatMap((tool) => tool.deliveryModes))].sort();
const standards = [...new Set(tools.flatMap((tool) => tool.standards))].sort();
const sourceLicenses = [...new Set(tools.map((tool) => tool.sourceLicense))].sort();
const pricingModels = [...new Set(tools.flatMap((tool) => tool.pricingModels))].sort();
const modes = [...new Set(tools.flatMap((tool) => tool.modelingModes))].sort();
const toolTypes = [...new Set(tools.flatMap((tool) => tool.toolTypes))].sort();
const runtimeHosts = [...new Set(tools.flatMap((tool) => [...tool.runtimes, ...tool.hostApplications]))].sort();
const capabilityLabels: Record<keyof Tool['features'], string> = {
  xmiImport: 'XMI import',
  xmiExport: 'XMI export',
  collaboration: 'Team collaboration',
  codeGeneration: 'Code generation',
  reverseEngineering: 'Reverse engineering',
  simulation: 'Model simulation',
  requirementsManagement: 'Requirements management',
  sysmlV2Api: 'SysML v2 API',
};
const capabilities = Object.entries(capabilityLabels).filter(([key]) =>
  tools.some((tool) => tool.features[key as keyof Tool['features']] === 'Yes')
);
---

<section class="directory" data-tool-directory data-defer-results={deferResults ? 'true' : undefined}>
  <div class="filter-panel panel">
    <div class="search-row">
      <label for="tool-search">Search the directory</label>
      <input id="tool-search" type="search" placeholder="Tool, vendor, or capability…" data-filter-search />
    </div>
    <div class="filter-grid filter-grid--primary">
      <label>Operating system
        <select data-filter="os">
          <option value="">All operating systems</option>
          {operatingSystems.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
        </select>
      </label>
      <label>Delivery / access
        <select data-filter="delivery">
          <option value="">All delivery modes</option>
          {deliveryModes.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
        </select>
      </label>
      <label>Standard
        <select data-filter="standard">
          <option value="">All standards</option>
          {standards.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
        </select>
      </label>
      <label>Source license
        <select data-filter="source-license">
          <option value="">All source licenses</option>
          {sourceLicenses.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
        </select>
      </label>
      <label>Pricing
        <select data-filter="pricing">
          <option value="">All pricing models</option>
          {pricingModels.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
        </select>
      </label>
      <label>Capability
        <select data-filter="capability">
          <option value="">All capabilities</option>
          {capabilities.map(([value, label]) => <option value={value.toLowerCase()}>{label}</option>)}
        </select>
      </label>
    </div>
    <details class="advanced-filters">
      <summary>Advanced filters</summary>
      <div class="filter-grid filter-grid--advanced">
        <label>Runtime / host
          <select data-filter="runtime-host">
            <option value="">All runtimes and hosts</option>
            {runtimeHosts.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
          </select>
        </label>
        <label>Tool type
          <select data-filter="tool-type">
            <option value="">All tool types</option>
            {toolTypes.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
          </select>
        </label>
        <label>Modeling interface
          <select data-filter="mode">
            <option value="">All interfaces</option>
            {modes.map((item) => <option value={item.toLowerCase()}>{item}</option>)}
          </select>
        </label>
      </div>
    </details>
    <div class="filter-footer">
      <p aria-live="polite"><strong data-result-count>{tools.length}</strong><span data-result-label>{deferResults ? ' tools available' : ' tools shown'}</span></p>
      <button type="button" data-clear-filters>Clear filters</button>
    </div>
  </div>

  <div class="tool-grid" data-results hidden={deferResults}>
    {tools.map((tool) => (
      <div
        data-tool
        data-search={`${tool.name} ${tool.vendor} ${tool.description} ${tool.toolTypes.join(' ')} ${tool.operatingSystems.join(' ')} ${tool.deliveryModes.join(' ')} ${tool.runtimes.join(' ')} ${tool.hostApplications.join(' ')}`.toLowerCase()}
        data-os={tool.operatingSystems.join('|').toLowerCase()}
        data-delivery={tool.deliveryModes.join('|').toLowerCase()}
        data-standard={tool.standards.join('|').toLowerCase()}
        data-source-license={tool.sourceLicense.toLowerCase()}
        data-pricing={tool.pricingModels.join('|').toLowerCase()}
        data-runtime-host={[...tool.runtimes, ...tool.hostApplications].join('|').toLowerCase()}
        data-tool-type={tool.toolTypes.join('|').toLowerCase()}
        data-mode={tool.modelingModes.join('|').toLowerCase()}
        data-capability={Object.entries(tool.features).filter(([, value]) => value === 'Yes').map(([key]) => key.toLowerCase()).join('|')}
      >
        <ToolCard tool={tool} />
      </div>
    ))}
  </div>

  <div class="empty-state" data-empty-state hidden>
    <span aria-hidden="true">∅</span>
    <h2>No tools match those filters.</h2>
    <p>Try broadening the operating system, delivery, standard, licensing, or capability selection.</p>
    <button type="button" data-clear-filters>Reset the directory</button>
  </div>
</section>

<script>
  const directory = document.querySelector('[data-tool-directory]');
  if (directory instanceof HTMLElement) {
    const search = directory.querySelector('[data-filter-search]');
    const selects = [...directory.querySelectorAll('[data-filter]')];
    const tools = [...directory.querySelectorAll('[data-tool]')];
    const count = directory.querySelector('[data-result-count]');
    const countLabel = directory.querySelector('[data-result-label]');
    const results = directory.querySelector('[data-results]');
    const empty = directory.querySelector('[data-empty-state]');
    const deferResults = directory.dataset.deferResults === 'true';

    const applyFilters = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
      const values = Object.fromEntries(selects.map((select) => [select.getAttribute('data-filter'), select instanceof HTMLSelectElement ? select.value : '']));
      const hasActiveFilters = Boolean(query) || Object.values(values).some(Boolean);
      let visible = 0;

      tools.forEach((tool) => {
        if (!(tool instanceof HTMLElement)) return;
        const matches = (!query || tool.dataset.search?.includes(query))
          && (!values.os || tool.dataset.os?.split('|').includes(values.os))
          && (!values.delivery || tool.dataset.delivery?.split('|').includes(values.delivery))
          && (!values.standard || tool.dataset.standard?.split('|').includes(values.standard))
          && (!values['source-license'] || tool.dataset.sourceLicense === values['source-license'])
          && (!values.pricing || tool.dataset.pricing?.split('|').includes(values.pricing))
          && (!values['runtime-host'] || tool.dataset.runtimeHost?.split('|').includes(values['runtime-host']))
          && (!values['tool-type'] || tool.dataset.toolType?.split('|').includes(values['tool-type']))
          && (!values.mode || tool.dataset.mode?.split('|').includes(values.mode))
          && (!values.capability || tool.dataset.capability?.split('|').includes(values.capability));
        tool.hidden = !matches;
        if (matches) visible += 1;
      });

      const resultsDeferred = deferResults && !hasActiveFilters;
      if (results instanceof HTMLElement) results.hidden = resultsDeferred;
      if (count) count.textContent = String(resultsDeferred ? tools.length : visible);
      if (countLabel) countLabel.textContent = resultsDeferred ? ' tools available' : ' tools shown';
      if (empty instanceof HTMLElement) empty.hidden = resultsDeferred || visible !== 0;
    };

    const clearFilters = () => {
      if (search instanceof HTMLInputElement) search.value = '';
      selects.forEach((select) => { if (select instanceof HTMLSelectElement) select.value = ''; });
      applyFilters();
      if (search instanceof HTMLInputElement) search.focus();
    };

    search?.addEventListener('input', applyFilters);
    selects.forEach((select) => select.addEventListener('change', applyFilters));
    directory.querySelectorAll('[data-clear-filters]').forEach((button) => button.addEventListener('click', clearFilters));

    const params = new URLSearchParams(window.location.search);
    if (search instanceof HTMLInputElement) search.value = params.get('q') ?? '';
    const presetFilters = {
      os: params.get('os') ?? params.get('platform'),
      delivery: params.get('delivery'),
      standard: params.get('standard'),
      'source-license': params.get('sourceLicense') ?? params.get('license'),
      pricing: params.get('pricing'),
      'runtime-host': params.get('runtime'),
      'tool-type': params.get('type'),
      mode: params.get('mode'),
      capability: params.get('capability'),
    };
    Object.entries(presetFilters).forEach(([filter, value]) => {
      const select = directory.querySelector(`[data-filter="${filter}"]`);
      if (value && select instanceof HTMLSelectElement) {
        select.value = value.toLowerCase().replaceAll('-', ' ');
      }
    });
    applyFilters();
  }
</script>

<style>
  .directory { display: grid; gap: 1.5rem; }
  .filter-panel { padding: 1.2rem; }
  .search-row label, .filter-grid label { display: grid; gap: .42rem; color: var(--ink-soft); font-size: .74rem; font-weight: 800; letter-spacing: .045em; text-transform: uppercase; }
  input, select { width: 100%; min-height: 48px; border: 1px solid var(--line); border-radius: 11px; background: var(--white); color: var(--ink); }
  input { padding: .75rem 1rem; font-size: 1rem; }
  select { padding: .65rem .75rem; }
  .filter-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .75rem; margin-top: .8rem; }
  .filter-grid--primary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .filter-grid--advanced { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .advanced-filters { margin-top: 1rem; border-top: 1px solid var(--line); }
  .advanced-filters summary { width: fit-content; padding-top: .9rem; color: var(--teal-dark); cursor: pointer; font-size: .78rem; font-weight: 800; }
  .filter-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--line); }
  .filter-footer p { margin: 0; color: var(--ink-soft); font-size: .84rem; }
  button { border: 0; background: transparent; color: var(--teal-dark); cursor: pointer; font-weight: 800; }
  [data-results][hidden] { display: none; }
  [data-tool][hidden] { display: none; }
  .empty-state { padding: 4rem 1rem; border: 1px dashed var(--line); border-radius: var(--radius); text-align: center; }
  .empty-state span { font-family: var(--font-mono); font-size: 3rem; }
  .empty-state p { color: var(--ink-soft); }
  .empty-state button { margin-top: .5rem; padding: .7rem 1rem; border: 1px solid var(--teal); border-radius: 999px; }
  @media (max-width: 800px) { .filter-grid, .filter-grid--primary, .filter-grid--advanced { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .filter-grid { grid-template-columns: 1fr; } }
</style>
