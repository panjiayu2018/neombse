---
import type { Tool } from '../types';
import { formatDate } from '../lib/tools';

interface Props { tool: Tool; }
const { tool } = Astro.props;
---

<article class="tool-card">
  <div class="tool-card__top">
    {tool.image
      ? <span class="tool-card__image"><img src={tool.image} alt="" loading="lazy" /></span>
      : <span class="tool-card__initial" aria-hidden="true">{tool.name.slice(0, 1)}</span>}
    <span class="tool-card__status">Checked {formatDate(tool.lastChecked)}</span>
  </div>
  <div>
    <p class="tool-card__vendor">{tool.vendor}</p>
    <h3><a href={`/tools/${tool.id}/`}>{tool.name}</a></h3>
    <p class="tool-card__description">{tool.description}</p>
  </div>
  <div class="tag-row">
    {tool.platforms.slice(0, 2).map((item) => <span class="tag">{item}</span>)}
    {tool.standards.slice(0, 2).map((item) => <span class="tag tag--standard">{item}</span>)}
    <span class="tag">{tool.licenseTypes[0]}</span>
  </div>
  <a class="tool-card__link" href={`/tools/${tool.id}/`}>
    Review tool <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .tool-card { display: flex; min-height: 365px; flex-direction: column; gap: 1.25rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255,253,248,.78); transition: transform 180ms ease, box-shadow 180ms ease; }
  .tool-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .tool-card__top { display: flex; align-items: center; justify-content: space-between; gap: .8rem; }
  .tool-card__initial { display: grid; width: 48px; height: 48px; place-items: center; border-radius: 14px; background: var(--ink); color: var(--paper); font-size: 1.35rem; font-weight: 900; }
  .tool-card__image { display: grid; width: 72px; height: 56px; place-items: center; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: white; }
  .tool-card__image img { width: 100%; height: 100%; object-fit: contain; }
  .tool-card__status { color: var(--ink-soft); font-family: var(--font-mono); font-size: .64rem; text-align: right; }
  .tool-card__vendor { margin-bottom: .25rem; color: var(--teal); font-family: var(--font-mono); font-size: .68rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  h3 a { text-decoration: none; }
  h3 a::after { position: absolute; inset: 0; content: ""; }
  .tool-card { position: relative; }
  .tool-card__description { margin: .75rem 0 0; color: var(--ink-soft); }
  .tag-row, .tool-card__link { position: relative; z-index: 1; }
  .tag--standard { border-color: rgba(12,111,114,.35); background: rgba(12,111,114,.08); color: var(--teal-dark); }
  .tool-card__link { display: flex; justify-content: space-between; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--teal-dark); font-weight: 800; text-decoration: none; }
</style>
